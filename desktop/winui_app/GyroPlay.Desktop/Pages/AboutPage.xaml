<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GyroPlay.Desktop.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="18">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <Image
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Left"
                        Source="ms-appx:///Assets/Square150x150Logo.png"
                        Stretch="Uniform" />
                    <TextBlock FontSize="34" FontWeight="SemiBold" Text="GyroPlay" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock TextWrapping="Wrap" Text="GyroPlay is an open-source mobile-to-PC controller bridge for racing games. It pairs an Android phone with a Windows virtual Xbox controller through a local UDP engine." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="GitHubButton_Click" Content="GitHub" />
                        <Button Click="TroubleshootingButton_Click" Content="Open troubleshooting" />
                    </StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="License and acknowledgements" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="GyroPlay uses Flutter, WinUI 3, Python, vgamepad, ViGEmBus, and QRCoder. Add the final repository license before public redistribution." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

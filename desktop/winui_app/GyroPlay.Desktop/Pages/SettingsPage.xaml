<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GyroPlay.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock FontSize="32" FontWeight="SemiBold" Text="Settings" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Control startup behavior, notifications, and theme." />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <ToggleSwitch x:Name="StartEngineToggle" Header="Start engine automatically when GyroPlay opens" Toggled="SettingChanged" />
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Header="Minimize to tray when the window is closed" Toggled="SettingChanged" />
                    <ToggleSwitch x:Name="LaunchWithWindowsToggle" Header="Launch GyroPlay with Windows" Toggled="SettingChanged" />
                    <ToggleSwitch x:Name="NotificationsToggle" Header="Show connection notifications" Toggled="SettingChanged" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Theme" />
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

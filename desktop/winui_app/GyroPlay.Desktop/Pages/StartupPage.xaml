<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GyroPlay.Desktop.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48">
        <StackPanel
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18">
            <Image
                Width="78"
                Height="78"
                Source="ms-appx:///Assets/Square150x150Logo.png"
                Stretch="Uniform" />
            <TextBlock
                FontSize="40"
                FontWeight="SemiBold"
                Text="GyroPlay" />
            <TextBlock
                Foreground="{StaticResource MutedTextBrush}"
                Text="Preparing your desktop controller bridge." />
            <ProgressRing
                x:Name="LoadingRing"
                Width="32"
                Height="32"
                HorizontalAlignment="Left"
                IsActive="True" />
            <TextBlock x:Name="StatusText" Text="Starting..." />
            <ItemsControl x:Name="ChecksList" />
        </StackPanel>
    </Grid>
</Page>

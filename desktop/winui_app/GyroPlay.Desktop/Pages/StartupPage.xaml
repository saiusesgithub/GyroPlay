<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GyroPlay.Desktop.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48">
        <StackPanel
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18">
            <Border
                Width="72"
                Height="72"
                Background="{StaticResource GyroPlayAccentBrush}"
                CornerRadius="18">
                <FontIcon
                    FontSize="34"
                    Foreground="#101318"
                    Glyph="&#xE7FC;" />
            </Border>
            <TextBlock
                FontSize="40"
                FontWeight="SemiBold"
                Text="GyroPlay" />
            <TextBlock
                Foreground="{StaticResource MutedTextBrush}"
                Text="Preparing your desktop controller bridge." />
            <ProgressRing
                x:Name="LoadingRing"
                Width="32"
                Height="32"
                HorizontalAlignment="Left"
                IsActive="True" />
            <TextBlock x:Name="StatusText" Text="Starting..." />
            <ItemsControl x:Name="ChecksList" />
        </StackPanel>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GyroPlay.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GyroPlay">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#111318">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,24,28,10">
            <TextBlock
                Text="GyroPlay"
                FontSize="34"
                FontWeight="SemiBold" />
            <TextBlock
                Text="Desktop control panel"
                Foreground="#9BA4B5"
                FontSize="15" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,10,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="14">
                <Border
                    Padding="18"
                    Background="#1A1D24"
                    BorderBrush="#2A2F3A"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Text="Connection"
                            FontSize="20"
                            FontWeight="SemiBold" />

                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Local IPv4" Foreground="#9BA4B5" />
                            <TextBlock x:Name="LocalIpText" Grid.Row="0" Grid.Column="1" Text="Detecting..." />

                            <TextBlock Grid.Row="1" Text="UDP port" Foreground="#9BA4B5" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="5005" />

                            <TextBlock Grid.Row="2" Text="Engine" Foreground="#9BA4B5" />
                            <TextBlock x:Name="EngineStatusText" Grid.Row="2" Grid.Column="1" Text="Stopped" />

                            <TextBlock Grid.Row="3" Text="Phone" Foreground="#9BA4B5" />
                            <TextBlock x:Name="PhoneStatusText" Grid.Row="3" Grid.Column="1" Text="Disconnected" />

                            <TextBlock Grid.Row="4" Text="Last packet" Foreground="#9BA4B5" />
                            <TextBlock x:Name="LastPacketText" Grid.Row="4" Grid.Column="1" Text="Never" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="18"
                    Background="#1A1D24"
                    BorderBrush="#2A2F3A"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Easy pairing"
                            FontSize="20"
                            FontWeight="SemiBold" />

                        <Border
                            HorizontalAlignment="Left"
                            Padding="10"
                            Background="White"
                            CornerRadius="6">
                            <Image
                                x:Name="PairingQrImage"
                                Width="190"
                                Height="190" />
                        </Border>

                        <TextBlock
                            x:Name="TokenExpiryText"
                            Foreground="#9BA4B5"
                            Text="Expires: -" />

                        <TextBlock
                            Text="Manual token"
                            Foreground="#9BA4B5" />

                        <TextBlock
                            x:Name="PairingTokenText"
                            FontFamily="Consolas"
                            FontSize="18"
                            Text="-" />

                        <Button
                            x:Name="RefreshPairingButton"
                            Content="Refresh Pairing Code"
                            HorizontalAlignment="Stretch"
                            Click="RefreshPairingButton_Click" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="18"
                    Background="#1A1D24"
                    BorderBrush="#2A2F3A"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Engine controls"
                            FontSize="20"
                            FontWeight="SemiBold" />

                        <Button
                            x:Name="StartEngineButton"
                            Content="Start Engine"
                            HorizontalAlignment="Stretch"
                            Click="StartEngineButton_Click" />

                        <Button
                            x:Name="StopEngineButton"
                            Content="Stop Engine"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="StopEngineButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                Grid.Column="2"
                Padding="18"
                Background="#0B0D12"
                BorderBrush="#2A2F3A"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="Engine log"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12" />

                    <TextBox
                        x:Name="LogTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="13"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Background="#05070A"
                        BorderBrush="#20242D" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

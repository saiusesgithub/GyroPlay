<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GyroPlay.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GyroPlay.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GyroPlay"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="PreflightHost" Visibility="Visible" />

        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="RootNavigation_SelectionChanged"
            Visibility="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeItem"
                    Content="Home"
                    Icon="Home"
                    Tag="home"
                    ToolTipService.ToolTip="Home dashboard" />
                <NavigationViewItem
                    Content="Setup &amp; Diagnostics"
                    Icon="Repair"
                    Tag="diagnostics"
                    ToolTipService.ToolTip="Setup and diagnostics" />
                <NavigationViewItem
                    Content="Settings"
                    Icon="Setting"
                    Tag="settings"
                    ToolTipService.ToolTip="Application settings" />
                <NavigationViewItem
                    Content="About"
                    Icon="Help"
                    Tag="about"
                    ToolTipService.ToolTip="About GyroPlay" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
